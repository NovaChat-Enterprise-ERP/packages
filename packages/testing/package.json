{
  "name": "@novachat-enterprise-erp/testing",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@novachat-enterprise-erp/common": "workspace:^",
    "@novachat-enterprise-erp/contracts": "workspace:^",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@novachat-enterprise-erp/tsconfig": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NovaChat-Enterprise-ERP/packages.git",
    "directory": "packages/testing"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
