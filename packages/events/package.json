{
  "name": "@novachat-enterprise-erp/events",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@novachat-enterprise-erp/contracts": "workspace:^",
    "ioredis": "5.11.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@novachat-enterprise-erp/tsconfig": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NovaChat-Enterprise-ERP/packages.git",
    "directory": "packages/events"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
